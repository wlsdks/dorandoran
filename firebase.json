{
  "functions": {
    "source": "functions",
    "ignore": [
      "node_modules",
      ".git",
      "*.log"
    ]
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "/api/staff/**",
        "function": "staffApi",
        "region": "asia-northeast3"
      },
      {
        "source": "/api/assignments/**",
        "function": "assignmentApi",
        "region": "asia-northeast3"
      },
      {
        "source": "/api/classroom/**",
        "function": "classroomApi",
        "region": "asia-northeast3"
      },
      {
        "source": "/api/gemini/**",
        "function": "geminiProxy",
        "region": "asia-northeast3"
      },
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      },
      {
        "source": "**/!(*.@(js|css|png|jpg|jpeg|svg|webp|woff|woff2|br|gz|json))",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          }
        ]
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  },
  "storage": {
    "rules": "storage.rules"
  }
}

rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    function own(uid) { return request.auth != null && request.auth.uid == uid; }
    function teacher() { return request.auth != null && request.auth.token.approved == true && request.auth.token.role in ['master', 'admin']; }
    function raster() { return request.resource != null && request.resource.size <= 10 * 1024 * 1024 && request.resource.contentType.matches('image/(jpeg|png|webp|gif)'); }
    match /questions/{uid}/{file=**} {
      allow read: if own(uid);
      allow create, update: if own(uid) && teacher() && raster();
      allow delete: if own(uid) && teacher();
    }
    match /ai-judge/{sid}/{qid}/{uid}/{file=**} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid) && raster();
    }
    match /assignments/{aid}/{uid}/{file=**} {
      allow read, delete: if own(uid);
      allow create, update: if own(uid) && raster();
    }
    match /{file=**} { allow read, write: if false; }
  }
}

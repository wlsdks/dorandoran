{
  "name": "dorandoran",
  "description": "실시간 강의 참여 플랫폼 — 강사/스태프/학생/전자칠판 4모드 + AI 심사 7판사",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run licenses:check && vite build",
    "licenses:check": "node scripts/generate-third-party-notices.mjs --check",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs",
    "check": "npm run lint && npm run test -- --run && npm run build",
    "lint": "eslint .",
    "test": "vitest",
    "preview": "vite preview",
    "test:integration": "npx --yes firebase-tools@15.32.1 emulators:exec --project demo-dorandoran --only auth,database,storage --config firebase.qa.json \"node tests/support/run-integration.mjs\"",
    "brand:generate": "node scripts/generate-brand-assets.mjs"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@google/genai": "^2.27.0",
    "firebase": "^12.19.0",
    "framer-motion": "^14.0.0",
    "jszip": "^3.10.2",
    "lottie-react": "^3.1.2",
    "lucide-react": "^1.52.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "tailwindcss": "^4.3.3",
    "vite": "^8.3.2",
    "vite-plugin-compression": "^0.5.1",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "overrides": {
    "@grpc/grpc-js": "^1.14.5",
    "protobufjs": "^7.6.6"
  }
